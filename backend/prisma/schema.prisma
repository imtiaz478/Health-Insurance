generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
}

enum ClaimStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum InsuranceType {
  HEALTH
  MOTOR
  FIRE
  MARINE
  ENGINEERING
  TRAVEL
  LIFE
  OTHER
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BKASH
  NAGAD
  CARD
}

enum DocumentType {
  NID_FRONT
  NID_BACK
  CUSTOMER_PHOTO
  SUPPORTING_DOCUMENT
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RenewalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Customer {
  id           String   @id @default(uuid())
  name         String
  email        String?
  phone        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotes             Quote[]
  claims             Claim[]
  policyApplications PolicyApplication[]
  policies           Policy[]
  payments           Payment[]
  documents          Document[]
  renewals           PolicyRenewal[]
}

model Quote {
  id            String        @id @default(uuid())
  customerId    String
  insuranceType InsuranceType
  details       String?       @db.Text
  status        QuoteStatus   @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Claim {
  id           String      @id @default(uuid())
  customerId   String
  policyNumber String?
  description  String      @db.Text
  status       ClaimStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id])
  documents Document[]
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PolicyApplication {
  id             String            @id @default(uuid())
  customerId     String
  insuranceType  InsuranceType
  coverageAmount Decimal           @db.Decimal(15, 2)
  details        String?           @db.Text
  status         ApplicationStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id])
  policy    Policy?
  documents Document[]
}

model Policy {
  id                 String        @id @default(uuid())
  policyNumber       String        @unique
  customerId         String
  insuranceType      InsuranceType
  coverageAmount     Decimal       @db.Decimal(15, 2)
  premiumAmount      Decimal       @db.Decimal(15, 2)
  startDate          DateTime
  expiryDate         DateTime
  status             PolicyStatus  @default(ACTIVE)
  details            String?       @db.Text
  policyApplicationId String?      @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer          Customer          @relation(fields: [customerId], references: [id])
  policyApplication PolicyApplication? @relation(fields: [policyApplicationId], references: [id])
  payments          Payment[]
  renewals          PolicyRenewal[]
}

model Payment {
  id            String        @id @default(uuid())
  customerId    String
  policyId      String
  amount        Decimal       @db.Decimal(15, 2)
  paymentMethod PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  policy   Policy   @relation(fields: [policyId], references: [id])

  @@index([customerId])
  @@index([policyId])
  @@index([status])
}

model Document {
  id                  String         @id @default(uuid())
  customerId          String
  policyApplicationId String?
  claimId             String?
  documentType        DocumentType
  fileName            String
  fileUrl             String         @db.Text
  status              DocumentStatus @default(PENDING)
  rejectionReason     String?        @db.Text
  verifiedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  customer          Customer          @relation(fields: [customerId], references: [id])
  policyApplication PolicyApplication? @relation(fields: [policyApplicationId], references: [id])
  claim             Claim?            @relation(fields: [claimId], references: [id])

  @@index([customerId])
  @@index([policyApplicationId])
  @@index([claimId])
  @@index([status])
}

model PolicyRenewal {
  id              String        @id @default(uuid())
  policyId        String
  customerId      String
  status          RenewalStatus @default(PENDING)
  oldExpiryDate   DateTime
  newExpiryDate   DateTime?
  premiumAmount   Decimal       @db.Decimal(15, 2)
  rejectionReason String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  policy   Policy   @relation(fields: [policyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([policyId])
  @@index([customerId])
  @@index([status])
}